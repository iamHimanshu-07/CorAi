# ============================================================================
# CorAi — example environment file.
# Copy to `.env` (which is git-ignored) for local dev, OR set these in your
# deployment platform's dashboard (Render / Railway / HF Spaces / Fly / etc.).
# ============================================================================

# ---- Flask core ------------------------------------------------------------
FLASK_CONFIG=config.Config
SECRET_KEY=replace-me-with-something-random
PORT=7860                                # HF Spaces default; Render/Railway override
SESSION_COOKIE_SECURE=0                  # set to 1 in production

# ---- Persistent data --------------------------------------------------------
# Leave unset to use repo-local paths (dev). On Render / Railway / HF Spaces
# with a Storage Bucket, set these to the persistent volume (defaults shown).
# DATABASE_URL=sqlite:////data/corai.db
# MODEL_PATH=/data/models/corai-1.0.0.pkl
# CorAi_RAG_INDEX=/data/.rag_cache/corai_index
# CorAi_HF_CACHE=/data/.hf_cache

# ---- Bootstrap admin -------------------------------------------------------
BOOTSTRAP_DOCTOR_USERNAME=doctor
BOOTSTRAP_DOCTOR_PASSWORD=corai2026
BOOTSTRAP_DOCTOR_EMAIL=doctor@corai.local
BOOTSTRAP_DOCTOR_AREA=India

# ---- RAG chatbot (HeartAI Copilot) -----------------------------------------
# Set EITHER GOOGLE_API_KEY (current) or GEMINI_API_KEY (legacy).
# Leave blank to disable the chatbot — the rest of the app still works.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# OpenAI fallback for the chatbot (optional).
# LLM_API_KEY=
# LLM_MODEL=gpt-3.5-turbo

# ---- Misc ------------------------------------------------------------------
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# ABOUT_US_SOURCE_URL=https://www.who.int/news-room
# RATELIMIT_STORAGE_URI=memory://

# ---- Hugging Face Spaces (Docker) ------------------------------------------
# HF Spaces does NOT load .env files — variables go in
# Space → Settings → Variables and secrets. The same names above are used.
# Minimum required for a working free deploy:
#   SECRET_KEY                  (required — generate a random value)
#   BOOTSTRAP_DOCTOR_PASSWORD   (required — set your own)
# Optional but recommended:
#   GOOGLE_API_KEY              (enables the HeartAI Copilot chatbot)
# Persistent data on free Spaces: leave DATABASE_URL / MODEL_PATH unset; the
# Dockerfile will retrain + re-seed the DB on every cold start. To persist,
# attach a Storage Bucket and set the four CorAi_DATA_DIR env vars above.
